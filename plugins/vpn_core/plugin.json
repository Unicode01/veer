{
  "api_version": "v1",
  "id": "vpn_core",
  "name": "VPN WAN",
  "version": "0.13.0",
  "kind": "pipeline",
  "stability": "lab",
  "description": "Opt-in VPN WAN adapters for kernel WireGuard, Mihomo, sing-box and external TUN cores.",
  "compatibility": {
    "os": [
      "linux"
    ],
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": [
      "control.native.v1",
      "control.exec.v1",
      "control.net_admin",
      "control.events.v1",
      "control.net_events.v1",
      "control.typed_services.v1",
      "dataplane.tc_pipeline.v2",
      "dataplane.hook_bindings.v1",
      "ui.capabilities.v1",
      "control.process.v1",
      "control.process_binaries.v1",
      "control.http_client.v1",
      "control.durable_operations.v1",
      "control.workers"
    ],
    "tc_pipeline_abi": 2
  },
  "control": {
    "library": {
      "x86_64-linux-gnu": {
        "path": "lib/x86_64-linux-gnu/libvpn_core.so"
      },
      "x86_64-linux-musl": {
        "path": "lib/x86_64-linux-musl/libvpn_core.so"
      },
      "aarch64-linux-gnu": {
        "path": "lib/aarch64-linux-gnu/libvpn_core.so"
      },
      "aarch64-linux-musl": {
        "path": "lib/aarch64-linux-musl/libvpn_core.so"
      }
    },
    "worker": "shared",
    "permissions": [
      "exec",
      "net.admin",
      "net.http",
      "net.dns",
      "worker",
      "event",
      "operation",
      "ebpf.load",
      "ebpf.map_read",
      "ebpf.map_write",
      "hook.attach",
      "plugin.action",
      "plugin.register",
      "plugin.resource",
      "resource",
      "kv",
      "secret",
      "timer",
      "ui"
    ],
    "net_access": [
      {
        "interfaces": [
          "*"
        ],
        "operations": [
          "link.read"
        ]
      },
      {
        "interfaces": [
          "veerwg*",
          "veervpn*"
        ],
        "operations": [
          "http",
          "dns"
        ],
        "remote_cidrs": [
          "0.0.0.0/0",
          "::/0"
        ]
      }
    ],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "sessions",
        "methods": [
          "get",
          "create",
          "update"
        ]
      },
      {
        "plugin": "wan_core",
        "resource": "status",
        "methods": [
          "get"
        ]
      }
    ],
    "action_access": [
      {
        "plugin": "wan_core",
        "actions": [
          "prepare_handoff",
          "teardown"
        ]
      }
    ],
    "register": {
      "capabilities": [
        "vpn",
        "wireguard",
        "mihomo",
        "sing_box",
        "wan",
        "tc_adapter",
        "control"
      ],
      "pipeline_nodes": [
        {
          "id": "vpn",
          "description": "VPN core attached to a WAN Core boundary."
        }
      ],
      "ebpf_objects": [
        {
          "id": "tunnel_adapter",
          "path": "tunnel_adapter.o",
          "programs": [
            {
              "id": "tc_adapter",
              "section": "tc/veer/pre_forward",
              "type": "tc"
            }
          ],
          "when": {
            "not_feature": "dataplane.kfuncs.handoff.v1"
          }
        },
        {
          "id": "tunnel_adapter",
          "path": "tunnel_adapter-kfuncs.o",
          "programs": [
            {
              "id": "tc_adapter",
              "section": "tc/veer/pre_forward",
              "type": "tc"
            }
          ],
          "when": {
            "feature": "dataplane.kfuncs.handoff.v1",
            "not_feature": "dataplane.kfuncs.handoff_ingress.v1"
          }
        },
        {
          "id": "tunnel_adapter",
          "path": "tunnel_adapter-direct.o",
          "programs": [
            {
              "id": "tc_adapter",
              "section": "tc/veer/pre_forward",
              "type": "tc"
            }
          ],
          "when": {
            "feature": "dataplane.kfuncs.handoff_ingress.v1"
          }
        }
      ],
      "pipeline_attach": [
        {
          "id": "tunnel-links",
          "direction": "forward",
          "attach": "ingress",
          "priority": 20,
          "program": "tunnel_adapter:tc_adapter",
          "mode": "rewrite",
          "binding_required": true
        },
        {
          "id": "tunnel-direct-out",
          "direction": "forward",
          "attach": "egress",
          "priority": 20,
          "program": "tunnel_adapter:tc_adapter",
          "mode": "rewrite",
          "binding_required": true
        }
      ],
      "resources": [
        {
          "id": "hook_bindings",
          "methods": [
            "list",
            "get"
          ],
          "control_methods": [
            "list",
            "get",
            "create",
            "update",
            "delete"
          ],
          "runtime_update": "plugin_reconcile",
          "max_records": 2,
          "max_record_bytes": 4096
        },
        {
          "id": "profiles",
          "schema_version": 3,
          "methods": [
            "list",
            "get",
            "create",
            "update"
          ],
          "control_methods": [
            "list",
            "get",
            "create",
            "update",
            "delete"
          ],
          "runtime_update": "manual",
          "max_records": 8,
          "max_record_bytes": 16384,
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "driver": {
                "type": "string",
                "enum": [
                  "wireguard",
                  "mihomo",
                  "sing_box",
                  "tun"
                ]
              },
              "core_path": {
                "type": "string"
              },
              "config_secret": {
                "type": "string"
              },
              "upstream_interface": {
                "type": "string"
              },
              "upstream_ip": {
                "type": "string"
              },
              "tun_interface": {
                "type": "string"
              },
              "tun_alias": {
                "type": "string"
              },
              "max_restarts": {
                "type": "integer"
              },
              "startup_timeout_seconds": {
                "type": "integer"
              },
              "slot": {
                "type": "integer"
              },
              "mtu": {
                "type": "integer"
              },
              "listen_port": {
                "type": "integer"
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remote_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "peers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "public_key": {
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "allowed_ips": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "keepalive": {
                      "type": "integer"
                    },
                    "preshared_key_secret": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "id": "status",
          "methods": [
            "list",
            "get"
          ],
          "control_methods": [
            "list",
            "get",
            "create",
            "update",
            "delete"
          ],
          "runtime_update": "manual",
          "max_records": 8,
          "max_record_bytes": 32768
        }
      ],
      "actions": [
        {
          "id": "set_key",
          "description": "Store a private or preshared key in the encrypted Secret store.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "set_core_config",
          "description": "Store JSON core configuration encrypted.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 1048576
        },
        {
          "id": "core_form",
          "description": "Read node names and advanced settings without credentials.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "health_status",
          "description": "Read actual VPN path probe results and settings.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "health_settings",
          "description": "Configure manual or periodic VPN path probes independently of the running tunnel.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 4096
        },
        {
          "id": "health_check",
          "description": "Queue a bounded asynchronous request through the applied VPN WAN.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "apply",
          "description": "Create or update a VPN WAN; select it in LAN or Egress NAT settings.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "teardown",
          "description": "Remove the owned VPN WAN and its TC adapter.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "delete_profile",
          "description": "Teardown the owned VPN WAN, then delete its draft and unshared credentials.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "inspect",
          "description": "Read public interface, peer, handshake and traffic state.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "upstream_interfaces",
          "description": "List interfaces a proxy core can use as its uplink.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_logs",
          "description": "Explicitly read managed core logs; output may contain credentials.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_status",
          "description": "List persistent core versions and installation progress.",
          "runtime_update": "runtime_query",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_install",
          "description": "Download and verify an official core release in the background.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_select",
          "description": "Choose an installed core for subsequently applied WANs.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_rollback",
          "description": "Restore the previous default core version.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        },
        {
          "id": "core_remove",
          "description": "Remove an unused installed core version.",
          "runtime_update": "runtime_apply",
          "max_payload_bytes": 2048
        }
      ],
      "subscriptions": [
        {
          "id": "vpn_links",
          "topic": "net.link",
          "handler": "onNetEvent",
          "queue_size": 64
        },
        {
          "id": "vpn_processes",
          "topic": "process.state",
          "handler": "onProcessEvent",
          "queue_size": 16,
          "when": {
            "feature": "control.process_events.v1"
          }
        }
      ],
      "ui": {
        "static_dir": "ui",
        "entry": "index.html",
        "page": "vpn",
        "page_title": "VPN",
        "resources": [
          {
            "resource": "profiles",
            "methods": [
              "list",
              "get",
              "create",
              "update"
            ]
          },
          {
            "resource": "status",
            "methods": [
              "list"
            ]
          }
        ],
        "actions": [
          "set_key",
          "set_core_config",
          "core_form",
          "health_status",
          "health_settings",
          "health_check",
          "apply",
          "teardown",
          "delete_profile",
          "inspect",
          "upstream_interfaces",
          "core_logs",
          "core_status",
          "core_install",
          "core_select",
          "core_rollback",
          "core_remove"
        ]
      }
    }
  },
  "dependencies": [
    {
      "id": "wan_core",
      "version": ">=1.5.6 <2.0.0"
    }
  ]
}
