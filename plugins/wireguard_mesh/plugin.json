{
  "api_version": "v1",
  "id": "wireguard_mesh",
  "name": "VPN WAN",
  "version": "0.5.2",
  "kind": "pipeline",
  "stability": "lab",
  "description": "Opt-in VPN WAN adapters for kernel WireGuard, Mihomo, sing-box and external TUN cores.",
  "compatibility": {
    "os": [
      "linux"
    ],
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": [
      "control.exec.v1",
      "control.net_admin",
      "control.typed_services.v1",
      "dataplane.tc_pipeline.v2",
      "dataplane.hook_bindings.v1",
      "ui.capabilities.v1",
      "control.process.v1",
      "control.process_binaries.v1"
    ],
    "tc_pipeline_abi": 2
  },
  "control": {
    "main": "control.js",
    "permissions": [
      "crypto",
      "exec",
      "net.admin",
      "ebpf.load",
      "ebpf.map_read",
      "ebpf.map_write",
      "hook.attach",
      "plugin.action",
      "plugin.register",
      "plugin.resource",
      "resource",
      "kv",
      "secret",
      "timer",
      "ui"
    ],
    "net_access": [{"interfaces": ["*"], "operations": ["link.read"]}],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "sessions",
        "methods": [
          "get",
          "create",
          "update"
        ]
      },
      {
        "plugin": "wan_core",
        "resource": "status",
        "methods": [
          "get"
        ]
      }
    ],
    "action_access": [
      {
        "plugin": "wan_core",
        "actions": [
          "prepare_handoff",
          "teardown"
        ]
      }
    ]
  },
  "dependencies": [
    {
      "id": "wan_core",
      "version": ">=1.5.0 <2.0.0"
    }
  ]
}
