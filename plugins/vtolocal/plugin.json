{
  "api_version": "v1",
  "id": "vtolocal",
  "name": "VTap To Local",
  "version": "1.2.2",
  "kind": "control",
  "stability": "stable",
  "description": "Creates one Linux L3 boundary for host egress and Veer reply injection without a veth peer.",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": ["control.net_admin", "control.typed_services.v1", "ui.capabilities.v1"]
  },
  "control": {
    "main": "control.js",
    "sha256": "9ede4374346e836da5fa7dc0492c388bafbb142f7fa44c25df2c8b8cebfe9746",
    "permissions": ["net.admin", "plugin.register", "resource", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["veer*", "local*", "vtolocal*"],
        "operations": ["addr.write", "link.create", "link.delete", "route.write"]
      }
    ]
  }
}
