{
  "api_version": "v1",
  "id": "pppoe_client",
  "name": "PPPoE Client",
  "version": "1.6.2",
  "kind": "pipeline",
  "stability": "stable",
  "description": "PPPoE WAN control and bidirectional TC pipeline integration.",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "tc_pipeline_abi": 2,
    "features": ["control.net_offloads.v1", "control.raw_l2", "control.typed_services.v1", "dataplane.tc_pipeline.v2", "ui.capabilities.v1"]
  },
  "dependencies": [
    {
      "id": "wan_core",
      "version": ">=1.5.0 <2.0.0"
    }
  ],
  "control": {
    "main": "control.js",
    "sha256": "8b569e48fbc47bf3749d5d6c8d3bec5b29dacbbf8086fbc8812b99e70e4b3f5e",
    "permissions": ["crypto", "ebpf.load", "ebpf.map_read", "ebpf.map_write", "hook.attach", "net.admin", "net.l2", "plugin.action", "plugin.register", "plugin.resource", "resource", "secret", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["en*", "eth*", "veer*", "lan*", "local*", "ppp*", "tap*", "veth*", "vmbr*", "wan*"],
        "operations": ["l2", "link.offload", "link.read", "link.state"]
      }
    ],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "sessions",
        "methods": ["create", "get", "update"]
      },
      {
        "plugin": "wan_core",
        "resource": "status",
        "methods": ["get"]
      }
    ],
    "action_access": [
      {
        "plugin": "wan_core",
        "actions": ["prepare_handoff"]
      }
    ]
  }
}
