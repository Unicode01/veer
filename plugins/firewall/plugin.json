{
  "api_version": "v1",
  "id": "firewall",
  "name": "Firewall",
  "version": "1.1.0",
  "kind": "pipeline",
  "stability": "stable",
  "description": "XDP source filter for ports, ICMP and IP protocols, with address sets, a security baseline and optional connection tracking, ahead of the Veer dataplane. Applied rule sets need confirmation or roll back by themselves.",
  "compatibility": {
    "os": ["linux"],
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "tc_pipeline_abi": 2,
    "kernel": ">=5.10.0",
    "features": [
      "dataplane.xdp_pipeline.v1",
      "dataplane.xdp_tc_fallback.v1",
      "dataplane.hook_bindings.v1",
      "ebpf.map_state.v1",
      "ebpf.map_transactions.v1",
      "ebpf.ring_push.v1",
      "control.net_admin",
      "control.modules.v1",
      "control.resource_schema.v1",
      "ui.capabilities.v1"
    ]
  },
  "control": {
    "main": "control.js",
    "sha256": "5f53a47a8d56e3e92706abcdeea17702184cabcf2a9cc1f6605ca9ce6c32ab0b",
    "permissions": [
      "crypto",
      "ebpf.load",
      "ebpf.map_read",
      "ebpf.map_write",
      "hook.attach",
      "kv",
      "net.admin",
      "plugin.register",
      "resource",
      "timer",
      "ui",
      "worker"
    ],
    "net_access": [
      {"interfaces": ["*"], "operations": ["link.read"]}
    ]
  }
}
