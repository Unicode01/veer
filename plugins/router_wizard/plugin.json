{
  "api_version": "v1",
  "id": "router_wizard",
  "name": "Router Wizard",
  "version": "0.4.1",
  "kind": "control",
  "stability": "lab",
  "description": "Single WAN/LAN router configuration page. It owns no dataplane program and only calls explicitly granted plugin resources/actions.",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": ["control.durable_operations.v1", "control.plugin_interop", "control.typed_services.v1", "ui.bridge.v1", "ui.capabilities.v1"]
  },
  "dependencies": [
    {
      "id": "lan_core",
      "version": ">=1.3.0 <2.0.0"
    },
    {
      "id": "pppoe_client",
      "version": ">=1.5.0 <2.0.0",
      "optional": true
    },
    {
      "id": "vtolocal",
      "version": ">=1.2.0 <2.0.0",
      "optional": true
    },
    {
      "id": "wan_core",
      "version": ">=1.4.0 <2.0.0",
      "optional": true
    }
  ],
  "control": {
    "main": "control.js",
    "permissions": ["operation", "plugin.register", "plugin.resource", "plugin.action", "resource", "timer", "ui"],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "status",
        "methods": ["get", "list"]
      },
      {
        "plugin": "lan_core",
        "resource": "status",
        "methods": ["get", "list"]
      },
      {
        "plugin": "lan_core",
        "resource": "egress_nat_plans",
        "methods": ["get", "list"]
      },
      {
        "plugin": "pppoe_client",
        "resource": "sessions",
        "methods": ["get", "list"]
      },
      {
        "plugin": "pppoe_client",
        "resource": "wan_links",
        "methods": ["get", "list"]
      },
      {
        "plugin": "vtolocal",
        "resource": "status",
        "methods": ["get", "list"]
      }
    ],
    "action_access": [
      {
        "plugin": "pppoe_client",
        "actions": ["dial", "disconnect", "clear_state"]
      },
      {
        "plugin": "wan_core",
        "actions": ["apply_session", "prepare_handoff", "teardown"]
      },
      {
        "plugin": "lan_core",
        "actions": ["apply_network", "teardown"]
      },
      {
        "plugin": "vtolocal",
        "actions": ["apply", "teardown"]
      }
    ]
  }
}
