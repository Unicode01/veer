{
  "api_version": "v1",
  "id": "lan_core",
  "name": "LAN Core",
  "version": "1.3.2",
  "kind": "control",
  "stability": "stable",
  "description": "Protocol-neutral LAN adapter with bridge, DHCPv4, inherited or manual DNS distribution, Egress NAT, and routed WAN IPv6 delegated-prefix support.",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": ["control.net_admin", "control.typed_services.v1", "plans.core.v1", "ui.capabilities.v1"]
  },
  "dependencies": [
    {
      "id": "wan_core",
      "version": ">=1.4.0 <2.0.0",
      "optional": true
    }
  ],
  "control": {
    "main": "control.js",
    "sha256": "ced65a521fe232ef48983ae45e5e8f73ab90513b00b2815e5f8a9d5c9876f4eb",
    "permissions": ["net.admin", "plugin.register", "plugin.resource", "resource", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["br*"],
        "operations": ["addr.write", "link.create", "link.delete", "link.master", "link.read"]
      },
      {
        "interfaces": ["vmbr*"],
        "operations": ["addr.write", "link.create", "link.master", "link.read"]
      },
      {
        "interfaces": ["en*", "eth*", "fw*", "lan*", "tap*", "veth*", "vmbr*"],
        "operations": ["link.master", "link.offload", "link.read"]
      },
      {
        "interfaces": ["veer*"],
        "operations": ["link.read"]
      }
    ],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "status",
        "methods": ["get", "list"]
      }
    ]
  }
}
