{
  "api_version": "v1",
  "id": "wan_core",
  "name": "WAN Core",
  "version": "1.6.1",
  "kind": "control",
  "stability": "stable",
  "description": "Protocol-neutral WAN adapter with direct and kernel-segmented Linux L3 handoff modes.",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "control_api_abi": 1,
    "features": ["control.net_admin", "control.net_policy.v1", "control.typed_services.v1", "ui.capabilities.v1"]
  },
  "control": {
    "main": "control.js",
    "sha256": "29a9095fa88480873432b4fa451317a3e2d584fd21226e82b2b2e2f17ea424ed",
    "permissions": ["net.admin", "plugin.register", "resource", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["veer*"],
        "operations": ["addr.write", "link.create", "link.delete", "link.offload", "link.read", "link.state", "neigh.write", "route.write", "rule.write"]
      }
    ]
  }
}
