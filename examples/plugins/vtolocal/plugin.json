{
  "api_version": "v1",
  "id": "vtolocal",
  "name": "VTap To Local",
  "version": "1.0.0",
  "kind": "control",
  "stability": "stable",
  "description": "Creates and maintains a local veth ingress pair so host-originated traffic can enter the fvtap pipeline through a real Linux interface.",
  "control": {
    "main": "control.js",
    "sha256": "99ba6a708f57211ed8aa28a9b54a87ccd65130fa50e80ebc09f08bf41b64a03e",
    "permissions": ["net.admin", "plugin.register", "resource", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["fwd*", "vtolocal*"],
        "operations": ["addr.write", "link.create", "link.delete", "route.write"]
      }
    ]
  }
}
