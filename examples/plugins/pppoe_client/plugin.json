{
  "api_version": "v1",
  "id": "pppoe_client",
  "name": "PPPoE Client",
  "version": "1.0.0",
  "kind": "pipeline",
  "stability": "stable",
  "description": "PPPoE WAN control and TC tunnel plugin for managed WAN handoff and fvtap pipeline integration.",
  "control": {
    "main": "control.js",
    "sha256": "75e440fe1312452fb0f338eaaef8a2404b7ed89a54bbb29d5627814aca86b64e",
    "permissions": ["crypto", "ebpf.load", "ebpf.map_read", "ebpf.map_write", "hook.attach", "net.admin", "net.l2", "plugin.register", "plugin.resource", "resource", "secret", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["en*", "eth*", "fwd*", "lan*", "ppp*", "tap*", "veth*", "vmbr*", "wan*"],
        "operations": ["l2", "link.offload", "link.read", "link.state"]
      }
    ],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "sessions",
        "methods": ["create", "get", "update"]
      }
    ]
  }
}
