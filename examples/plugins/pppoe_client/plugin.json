{
  "api_version": "v1",
  "id": "pppoe_client",
  "name": "PPPoE Client",
  "version": "1.0.0",
  "kind": "pipeline",
  "stability": "stable",
  "description": "PPPoE WAN control and TC tunnel plugin. The control script registers UI, resources, actions, eBPF objects, and TC hooks dynamically.",
  "control": {
    "main": "control.js",
    "sha256": "b6966a7acae28dfa3d38caac47987f432025a711492debda0365e0bff732a18e",
    "permissions": ["crypto", "ebpf.load", "ebpf.map_read", "ebpf.map_write", "hook.attach", "net.admin", "net.l2", "plugin.register", "plugin.resource", "resource", "secret", "timer", "ui"],
    "net_access": [
      {
        "interfaces": ["en*", "eth*", "fwd*", "lan*", "ppp*", "tap*", "veth*", "vmbr*", "wan*"],
        "operations": ["l2", "link.offload", "link.read", "link.state"]
      }
    ],
    "resource_access": [
      {
        "plugin": "wan_core",
        "resource": "sessions",
        "methods": ["create", "get", "update"]
      }
    ]
  }
}
