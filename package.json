{
  "name": "veer-webui-tests",
  "private": true,
  "scripts": {
    "test": "npm run test:web",
    "test:all": "npm run test:web && npm run test:sdk && npm run test:web:e2e",
    "test:sdk": "node --test sdk/plugin/test-host.test.cjs",
    "test:web": "node --test internal/app/web_test/*.test.js",
    "test:web:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
